PROJECT_NAME="Haazir API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM="HS256"

# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://kailasanadhg:@localhost:5432/haazir_db"
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="haazir_db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Platform Rates
PLATFORM_COMMISSION_PERCENTAGE=15.0
DEFAULT_TAX_PERCENTAGE=5.0
DEFAULT_EMERGENCY_SURCHARGE=150.0
DEFAULT_SERVICE_FEE=30.0
CANCELLATION_FEE=50.0
